              "shader": {
                "name": "pulse",
                "vertex": "#version 300 es\n// The vertex stage every full-target pass wants: `aUnit` is the unit quad the compositor binds,\n// and a pass covers the whole of what it draws into — so this maps (0,0)..(1,1) onto clip space\n// and hands the fragment the same 0..1 as its texture coordinate.\n//\n// It is a separate file, and duplicated per shader on purpose: a shader is the PAIR, and the day\n// one wants to move its geometry it needs this file to itself rather than a shared one it would\n// have to fork. See apps/k7-daw-frontend/packages/song-video/docs/shaders.md.\nin vec2 aUnit;\nout vec2 vUV;\n\nvoid main() {\n  vUV = aUnit;\n  gl_Position = vec4(aUnit * 2.0 - 1.0, 0.0, 1.0);\n}\n",
                "fragment": "#version 300 es\n// \"pulse\" — the picture brightens with the sound, inside a vignette.\n//\n// The simplest thing that shows the audio input actually arriving: wire a lane to this node's\n// `audio` port and the frame breathes with it. With nothing wired, `uAudio` is 0 and this is a\n// vignette and nothing else, which is a legitimate way to use it.\nprecision mediump float;\n\nin vec2 vUV;\n\nuniform sampler2D uTex;   // the picture coming in\nuniform float uAudio;     // 0..1, the wired lane's live level (-60..0 dB)\nuniform float uP1;        // how hard the sound lifts the picture\nuniform float uP2;        // vignette depth\n\nout vec4 outColor;\n\nvoid main() {\n  vec4 c = texture(uTex, vUV);\n\n  // Lift, never cut: at uAudio 0 this is 1.0, so silence leaves the picture exactly as it came in.\n  // A shader that darkened at rest would make every lane look wrong the moment you added it.\n  float lift = 1.0 + uAudio * uP1 * 2.0;\n\n  // Squared distance from the centre, doubled so the corners reach ~1 on a square frame.\n  vec2 d = vUV - 0.5;\n  float vig = 1.0 - uP2 * clamp(dot(d, d) * 2.0, 0.0, 1.0);\n\n  // Alpha is passed straight through. The layer is composited OVER whatever is under it, so\n  // writing 1.0 here would make a picture-in-picture punch a hole in the lane below it.\n  outColor = vec4(c.rgb * lift * vig, c.a);\n}\n"
              },
              "audioFrom": "drums"
            },
            {
              "id": "main:1",
              "type": "shader",
              "name": "00000000-0000-4000-8000-000000000003",
              "enabled": true,
              "params": {"P1": 1, "P2": 1, "P3": 1, "P4": 0},
              "shader": {
                "name": "video-mixer",
                "vertex": "#version 300 es\n// The full-target vertex stage every pass uses: the unit quad onto clip space, its 0..1 as the UV.\nin vec2 aUnit;\nout vec2 vUV;\n\nvoid main() {\n  vUV = aUnit;\n  gl_Position = vec4(aUnit * 2.0 - 1.0, 0.0, 1.0);\n}\n",
                "fragment": "#version 300 es\n// \"video-mixer\" — a lane's channels scaled and its alpha thinned: the strip a picture lane is mixed with.\n// The compositor blends straight alpha (SRC_ALPHA, ONE_MINUS_SRC_ALPHA), so transparency touches alpha alone.\nprecision mediump float;\n\nin vec2 vUV;\n\nuniform sampler2D uTex;\nuniform float uP1; // red\nuniform float uP2; // green\nuniform float uP3; // blue\nuniform float uP4; // transparency\n\nout vec4 outColor;\n\nvoid main() {\n  vec4 src = texture(uTex, vUV);\n  outColor = vec4(src.rgb * vec3(uP1, uP2, uP3), src.a * (1.0 - uP4));\n}\n"
              }
            }
