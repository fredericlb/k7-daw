                  "centre": {"type": "knob", "col": 0, "row": 2, "colSpan": 2, "rowSpan": 2, "label": "Centre", "bind": "Centre", "min": 0.5, "max": 12},
                  "feedback": {"type": "knob", "col": 2, "row": 2, "colSpan": 2, "rowSpan": 2, "label": "Fdbk", "bind": "Feedback", "min": 0, "max": 0.9},
                  "comb": {"type": "lcdscreen", "col": 0, "row": 4, "colSpan": 4, "rowSpan": 2}
                }
              }
