{
  "name": "@studio/take-render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The engine's offline bounce for its bench scripts: a ProjectDoc rendered to audio by this machine's engine binary. Consumed as source.",
  "exports": {
    "./renderer": "./src/renderer.ts",
    "./renderTypes": "./src/renderTypes.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@studio/engine-client": "*",
    "@studio/engine-protocol": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
