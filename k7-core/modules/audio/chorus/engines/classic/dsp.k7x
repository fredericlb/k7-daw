// Chorus (classic) — the DSP as data, the graph jsdsp.ts builds (docs/dsp-literal-plan.md).
params({
  Depth: { min: 0, max: 20, default: 3 },
  Speed: { min: 0, max: 10, default: 1 },
  Width: { min: 0, max: 1, default: 0.5 },
})
graph([
  input().as("dry"),
  lfo("sine", "Speed", mul("Width", 0.5)).as("sweep"),
  mul("Depth", 0.5).as("half"),
  output(delay("dry", aadd(amul("sweep", "half"), add(20, "half")), 45)),
])
