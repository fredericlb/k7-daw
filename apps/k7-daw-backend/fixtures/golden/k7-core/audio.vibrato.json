      "drums-wobble": {
        "from": "drums-wobble",
        "use": [
          {
            "module": "fx-wobble",
            "uses": "@k7-core/audio/vibrato",
            "stage": ["@input-volume", "@mix", "@output-volume"],
            "category": "audio",
            "emits": "audio",
            "stub": false,
            "hasNativePluginUI": false,
            "ui": {
              "cols": 8,
              "rows": 2,
              "widgets": {
                "amount": {"type": "knob", "col": 0, "row": 0, "colSpan": 2, "rowSpan": 2, "label": "Wobble", "bind": "Amount", "min": 0, "max": 100},
                "drift": {"type": "lcdscreen", "col": 2, "row": 0, "colSpan": 6, "rowSpan": 2}
              },
              "script": "// wobble — eight seconds of the delay line's drift: three sines at 0.23, 0.71 and 1.37 Hz, scaled by Amount.\n\nconst DRIFT = \"#ff6a1a\";\nconst GRID = \"#6b6b6b\";\nconst FONT = \"8px ui-monospace, monospace\";\nconst WINDOW_S = 8;\n// The largest swing dsp.k7x allows: 25 · (1 + 0.6 + 0.35) ms.\nconst MAX_MS = 48.75;\n\nconst clamp01 = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);\n\nexport default {\n  drift(lcd) {\n    const { ctx, width: W, height: H, params, output, state, now } = lcd;\n    ctx.fillStyle = \"#000\";\n    ctx.fillRect(0, 0, W, H);\n    ctx.font = FONT;\n    ctx.lineWidth = 1;\n\n    const pad = 6;\n    const top = 13;\n    const w = Math.max(1, W - pad * 2);\n    const h = Math.max(1, H - top - pad);\n    const mid = top + h / 2;\n    const amp = h / 2 - 1;\n\n    const t = clamp01((params[\"Amount\"] ?? 0) / 100);\n    const scale = 0.3 + 3 * t;\n    const depth = 25 * t;\n\n    ctx.strokeStyle = GRID;\n    ctx.beginPath();\n    ctx.moveTo(pad, Math.round(mid) + 0.5);\n    ctx.lineTo(W - pad, Math.round(mid) + 0.5);\n    ctx.stroke();\n\n    // Scrolls while audio flows through, still otherwise.\n    const out = Array.isArray(output) && output.length ? clamp01(output[output.length - 1] ?? 0) : 0;\n    state.out = (state.out ?? 0) * 0.7 + out * 0.3;\n    const t0 = state.out > 0.02 ? now / 1000 : 0;\n    const TAU = 2 * Math.PI;\n    ctx.strokeStyle = DRIFT;\n    ctx.beginPath();\n    for (let i = 0; i <= w; i++) {\n      const s = t0 + (i / w) * WINDOW_S;\n      const ms =\n        depth *\n        (Math.sin(TAU * scale * 0.23 * s) + 0.6 * Math.sin(TAU * scale * 0.71 * s) + 0.35 * Math.sin(TAU * scale * 1.37 * s));\n      const y = mid - (ms / MAX_MS) * amp;\n      if (i === 0) ctx.moveTo(pad + i, y);\n      else ctx.lineTo(pad + i, y);\n    }\n    ctx.stroke();\n\n    ctx.fillStyle = DRIFT;\n    ctx.textAlign = \"left\";\n    ctx.fillText(`±${(depth * 1.95).toFixed(1)} MS`, pad, 9);\n    ctx.fillStyle = GRID;\n    ctx.textAlign = \"right\";\n    ctx.fillText(`${WINDOW_S} S`, W - pad, 9);\n  },\n};\n",
              "vertical": {
                "cols": 4,
                "rows": 4,
                "widgets": {
                  "amount": {"type": "knob", "col": 0, "row": 0, "colSpan": 2, "rowSpan": 2, "label": "Wobble", "bind": "Amount", "min": 0, "max": 100},
                  "drift": {"type": "lcdscreen", "col": 0, "row": 2, "colSpan": 4, "rowSpan": 2}
                }
              }
            },
            "engines": ["vibrato", "wobble"],
            "engine": "wobble",
            "params": {"Amount": 0},
            "pluginId": "drums-wobble:fx-wobble"
          }
        ],
