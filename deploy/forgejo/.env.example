# Copy to .env beside compose.yaml and fill in (docs/forgejo-server.md). .env is never committed.

# The host name of the server, with a DNS A/AAAA record to the machine, e.g. git.example.org.
GIT_HOST=
# https on a server (Caddy fetches the certificate); http only for a local trial.
SCHEME=https
# Let's Encrypt's contact for the certificate.
ACME_EMAIL=

# Where the published ports listen: 0.0.0.0 on a server, 127.0.0.1 for a local trial.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Git over SSH; the host's own sshd keeps 22.
SSH_PORT=2222

# Forgejo's data (repositories, LFS, database) and Caddy's (the certificate).
DATA_DIR=./data
