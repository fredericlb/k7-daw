{
  "name": "@studio/k7-wasm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The browser's one WebAssembly module: Rust (song-schema, the song crate's decoders and views, k7x) behind a C ABI carrying JSON, its TypeScript loader, and its generated types and constants. The module is the checked-in file src/k7Wasm.wasm: a page fetches it as a hashed asset, node reads it from disk. Consumed as source.",
  "exports": {
    "./curve": "./src/curve.ts",
    "./schema": "./src/schema.ts",
    "./timecode": "./src/timecode.ts",
    "./validate": "./src/validate.ts",
    "./fields": "./src/fields.ts",
    "./module": "./src/module.ts",
    "./picture": "./src/picture.ts",
    "./records": "./src/records.ts",
    "./rules": "./src/rules.ts",
    "./stems": "./src/stems.ts",
    "./track": "./src/track.ts",
    "./k7x": "./src/k7x/index.ts",
    "./consts": "./src/consts.generated.ts",
    "./types": "./src/types/index.ts",
    "./boot": "./src/boot.ts",
    "./module.wasm": "./src/k7Wasm.wasm",
    "./engine": "./src/engine.ts",
    "./gesture": "./src/gesture.ts",
    "./gestureTicks": "./src/gestureTicks.ts",
    "./gestureTimeline": "./src/gestureTimeline.ts",
    "./eyes": "./src/eyes.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:wasm": "node scripts/buildWasm.mjs",
    "bench:outline": "tsx scripts/benchOutline.mts"
  },
  "engines": {
    "node": ">=22.3"
  },
  "devDependencies": {
    "@studio/graph-model": "*",
    "@studio/song-schema": "*",
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
