    "libraries": [
     {
      "name": "k7-core",
      "present": true,
      "versions": [
       {
        "version": 5,
        "requires": 1,
        "notes": "five"
       }
      ],
      "draft": true
     }
    ]
   }
  ],
  "after": {
   "data/libraries/k7-core/5/library.k7x": "name(\"k7-core\")\nversion(5)\nrequires(1)\nnotes(\"five\")\n",
   "data/libraries/k7-core/5/modules/mix.k7x": "plugin(\"mixer\")\n",
   "data/libraries/k7-core/draft/modules/mix.k7x": "plugin(\"mixer\")\n",
