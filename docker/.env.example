# Copy to .env beside docker-compose.yml, fill in, then `docker compose up -d`; later deploys go through deploy.sh (docs/images.md).

# Optional: the k7 image's tag. Empty, it is the release docker-compose.yml names,
# which scripts/check-version.mjs keeps equal to the root package.json's version.
# A deploy names a version, a stamp or a commit, never :latest, which moves under
# a running stack (docs/versioning.md).
APP_VERSION=

# Cookie signing secret, at least 32 characters (`openssl rand -hex 32`); k7
# refuses to start without one (apps/k7/backend/docs/hardening.md).
SESSION_SECRET=

# k7 refuses to start without an issuer and a client id, though nobody signs in on
# this host: any https URL and any name satisfy it.
OIDC_ISSUER=
OIDC_CLIENT_ID=

# The bearer a developer sends to publish the apps on /app_downloads — the same
# value as the developer's APP_RELEASE_TOKEN (`openssl rand -hex 32`). Empty
# refuses uploads; the page still serves what is there. Whoever holds it ships
# code to every installed app (docs/app-downloads.md).
APP_RELEASE_TOKEN=

# --- Traefik / hostnames ------------------------------------------------------
# The documentation host, and the root domain (answered with www. too): the root
# site, /app_downloads and the feed the desktop app updates from, which the app
# names as https://k7.rocks. Each name needs a DNS record pointing at this host.
DOCS_DOMAIN=docs.k7.rocks
SITE_DOMAIN=k7.rocks
# Your Traefik instance's certificate resolver name (traefik.toml / static config).
TRAEFIK_CERTRESOLVER=letsencrypt
