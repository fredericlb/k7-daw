            "ui": {
              "cols": 5,
              "rows": 2,
              "widgets": {
                "gain": {"type": "knob", "col": 0, "row": 0, "colSpan": 2, "rowSpan": 2, "label": "Gain", "bind": "Gain", "min": 0, "max": 1},
                "law_screen": {"type": "lcdscreen", "col": 2, "row": 0, "colSpan": 3, "rowSpan": 2}
              },
              "script": "// u-law-decode screens — the fixed mu-law curve (mu = 255) this module applies, with the live peak riding it.\nconst FONT = \"8px ui-monospace, monospace\";\nconst MU = 255;\nconst encode = (x) => Math.log(1 + MU * x) / Math.log(1 + MU);\nconst decode = (y) => (Math.pow(1 + MU, y) - 1) / MU;\n\nexport default {\n  law_screen(lcd) {\n    const { ctx, width: W, height: H, input } = lcd;\n    ctx.fillStyle = \"#000\";\n    ctx.fillRect(0, 0, W, H);\n    const curve = decode;\n    const pad = 4;\n    const w = Math.max(1, W - 2 * pad);\n    const h = Math.max(1, H - 2 * pad - 8);\n    const X = (v) => pad + v * w;\n    const Y = (v) => H - pad - v * h;\n    ctx.strokeStyle = \"#6b6b6b\";\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(X(0), Y(0));\n    ctx.lineTo(X(1), Y(1));\n    ctx.stroke();\n    ctx.strokeStyle = \"#ffffff\";\n    ctx.beginPath();\n    for (let i = 0; i <= 64; i++) {\n      const v = i / 64;\n      if (i === 0) ctx.moveTo(X(v), Y(curve(v))); else ctx.lineTo(X(v), Y(curve(v)));\n    }\n    ctx.stroke();\n    const last = input && input.length ? input[input.length - 1] : null;\n    if (typeof last === \"number\" && isFinite(last)) {\n      const v = Math.min(1, Math.max(0, last));\n      ctx.fillStyle = \"#ff6a1a\";\n      ctx.fillRect(X(v) - 2, Y(curve(v)) - 2, 4, 4);\n    }\n    ctx.font = FONT;\n    ctx.fillStyle = \"#ffffff\";\n    ctx.fillText(\"MU-LAW DECODE\", pad, 9);\n  },\n};\n",
              "vertical": {
                "cols": 4,
                "rows": 4,
                "widgets": {
                  "gain": {"type": "knob", "col": 0, "row": 0, "colSpan": 2, "rowSpan": 2, "label": "Gain", "bind": "Gain", "min": 0, "max": 1},
                  "law_screen": {"type": "lcdscreen", "col": 0, "row": 2, "colSpan": 4, "rowSpan": 2}
                }
              }
            },
            "params": {},
            "pluginId": "drums:fx"
          }
        ],
