              "widgets": {
                "mod_section": {"type": "group", "col": 0, "row": 0, "colSpan": 6, "rowSpan": 2, "label": "MOD", "color": "#3d7dff26"},
                "speed": {"type": "knob", "col": 0, "row": 0, "colSpan": 2, "rowSpan": 2, "label": "Speed", "bind": "Speed", "min": 0, "max": 10},
                "depth": {"type": "knob", "col": 2, "row": 0, "colSpan": 2, "rowSpan": 2, "label": "Depth", "bind": "Depth", "min": 0, "max": 20},
                "width": {"type": "knob", "col": 4, "row": 0, "colSpan": 2, "rowSpan": 2, "label": "Width", "bind": "Width", "min": 0, "max": 1},
                "sweep": {"type": "lcdscreen", "col": 0, "row": 2, "colSpan": 8, "rowSpan": 2}
              },
              "script": "// chorus-classic — the delay sweep over one second: Depth milliseconds either side, Speed cycles a second.\n\nconst SWEEP = \"#3d7dff\";\nconst GRID = \"#6b6b6b\";\nconst FONT = \"8px ui-monospace, monospace\";\nconst MAX_DEPTH = 20;\n\nconst clamp01 = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);\n\nexport default {\n  sweep(lcd) {\n    const { ctx, width: W, height: H, params, output, state, now } = lcd;\n    ctx.fillStyle = \"#000\";\n    ctx.fillRect(0, 0, W, H);\n    ctx.font = FONT;\n\n    const pad = 6;\n    const top = 13;\n    const w = Math.max(1, W - pad * 2);\n    const h = Math.max(1, H - top - pad);\n    const mid = top + h / 2;\n    const amp = h / 2 - 1;\n\n    const speed = Math.max(0, params[\"Speed\"] ?? 1);\n    const depth = Math.max(0, Math.min(MAX_DEPTH, params[\"Depth\"] ?? 3));\n\n    ctx.strokeStyle = GRID;\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(pad, Math.round(mid) + 0.5);\n    ctx.lineTo(W - pad, Math.round(mid) + 0.5);\n    ctx.stroke();\n\n    // The sweep scrolls while audio leaves the module, and stands still otherwise.\n    const out = Array.isArray(output) && output.length ? clamp01(output[output.length - 1] ?? 0) : 0;\n    state.out = (state.out ?? 0) * 0.7 + out * 0.3;\n    const phase = state.out > 0.02 ? (now / 1000) * speed : 0;\n    ctx.strokeStyle = SWEEP;\n    ctx.beginPath();\n    for (let i = 0; i <= w; i++) {\n      const y = mid - Math.sin(2 * Math.PI * (speed * (i / w) + phase)) * amp * (depth / MAX_DEPTH);\n      if (i === 0) ctx.moveTo(pad + i, y);\n      else ctx.lineTo(pad + i, y);\n    }\n    ctx.stroke();\n\n    ctx.fillStyle = SWEEP;\n    ctx.textAlign = \"left\";\n    ctx.fillText(`${speed.toFixed(1)} HZ`, pad, 9);\n    ctx.fillStyle = GRID;\n    ctx.textAlign = \"right\";\n    ctx.fillText(`±${depth.toFixed(1)} MS  1 S`, W - pad, 9);\n  },\n};\n",
              "vertical": {
                "cols": 4,
                "rows": 6,
                "widgets": {
                  "mod_section": {"type": "group", "col": 0, "row": 0, "colSpan": 4, "rowSpan": 4, "label": "MOD", "color": "#3d7dff26"},
                  "speed": {"type": "knob", "col": 0, "row": 0, "colSpan": 2, "rowSpan": 2, "label": "Speed", "bind": "Speed", "min": 0, "max": 10},
