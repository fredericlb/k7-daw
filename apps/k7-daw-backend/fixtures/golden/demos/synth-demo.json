        "plugins": [
          {
            "id": "kit:pattern",
            "type": "studio_pattern",
            "name": "Pattern",
            "path": "",
            "presetSave": "",
            "role": "",
            "enabled": true,
            "params": {},
            "patternSource": "// A live Strudel (TidalCycles-in-JS) pattern, linked by the \"pad\" and \"kit\" tracks.\n// The engine plays it on them while the transport rolls, locked to the beat — edit +\n// save to hear it change live.\n//\n// `.label(...)` names the lane a part plays on. A label matching a strudel track's\n// name lands there — \"Pad\" on the \"pad\" track, so it plays through that track's chain\n// and mixer strip. A label no track declares still plays, on the file's first track by\n// name (\"kit\"); so does an unlabelled part.\n//\n// What `s(...)` means is the event's business: a name found as a sample — in your\n// project's `samples/` folder, $DIRT_SAMPLES or $STRUDEL_SAMPLES — is a one-shot,\n// anything else is a note for the lane's instrument (\"sawtooth\" on \"pad\").\nstack(\n  note(\"c e g c5\").s(\"sawtooth\").slow(2).label(\"Pad\"),\n  sound(\"bd hh sn hh\").label(\"Kit\"),\n)\n",
            "patternLabel": "kit",
            "patternCatchAll": true,
            "patternClaimed": [
              "kit",
              "pad"
            ],
            "patternPlays": "both",
            "patternOnly": true,
            "patternBanks": [
              "<ws>/demos/synth-demo.k7/samples"
            ]
          }
        ],
