{
  "name": "@studio/song-schema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A song's FILE FORMAT and the value vocabulary around it: one zod schema and one reader/writer per kind of workspace (k7x) file, the media library's own YAML front end, plus the small pure modules a surface reads (moduleTypes, playlist, stems…). Nothing here touches node:fs, which is the whole point — this is the half of @studio/song a browser may import. Consumed as source.",
  "exports": {
    "./alternatives": "./src/alternatives.ts",
    "./engines": "./src/engines.ts",
    "./formatLevel": "./src/formatLevel.ts",
    "./audioFiles": "./src/audioFiles.ts",
    "./builtinParams": "./src/builtinParams.ts",
    "./curveVocab": "./src/curveVocab.ts",
    "./docExt": "./src/docExt.ts",
    "./libraryVersions": "./src/libraryVersions.ts",
    "./moduleFiles": "./src/moduleFiles.ts",
    "./moduleTypes": "./src/moduleTypes.ts",
    "./placementId": "./src/placementId.ts",
    "./presets": "./src/presets.ts",
    "./records": "./src/records.ts",
    "./reference": "./src/reference.ts",
    "./projectShapes": "./src/projectShapes.ts",
    "./fileStamp": "./src/fileStamp.ts",
    "./textOrder": "./src/textOrder.ts",
    "./trackColor": "./src/trackColor.ts",
    "./seriesColors": "./src/seriesColors.ts",
    "./yaml/entitySchemas": "./src/yaml/entitySchemas.ts",
    "./yaml/graphSchema": "./src/yaml/graphSchema.ts",
    "./yaml/mixViewSchema": "./src/yaml/mixViewSchema.ts",
    "./yaml/moduleFile": "./src/yaml/moduleFile.ts",
    "./yaml/moduleSchema": "./src/yaml/moduleSchema.ts",
    "./yaml/placementSchema": "./src/yaml/placementSchema.ts",
    "./yaml/projectSchema": "./src/yaml/projectSchema.ts",
    "./yaml/surfaceFile": "./src/yaml/surfaceFile.ts",
    "./yaml/surfaceSchema": "./src/yaml/surfaceSchema.ts",
    "./yaml/surfaceRegistry": "./src/yaml/surfaceRegistry.ts",
    "./keyframes": "./src/keyframes.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@studio/graph-model": "*",
    "@studio/k7-wasm": "*",
    "@studio/web-protocol": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
