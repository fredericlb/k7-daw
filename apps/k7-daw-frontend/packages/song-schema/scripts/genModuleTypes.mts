// genModuleTypes.mts — writes the song crate's module-type tables from moduleTypes.ts, so the TypeScript stays their one source.
// `--check` writes nothing and exits 1 when the file differs; run it without a flag through `npm run rebuild:generated`.

import { readFileSync, writeFileSync } from "node:fs";
import { join } from "node:path";
import { IO_MODULES, IO_SOURCES, MODULE_TYPES } from "../src/moduleTypes.ts";

const OUT = join(
  import.meta.dirname,
  "..",
  "..",
  "song",
  "rust",
  "src",
  "modules",
  "types_generated.rs",
);

const KIND: Record<string, string> = {
  io: "Io",
  doc: "Doc",
  plugin: "Plugin",
  track: "Track",
};
const TYPE: Record<string, string> = {
  audio: "Audio",
  midi: "Midi",
  video: "Video",
};
const q = (s: string) => JSON.stringify(s);

type Port = { name: string; type: string; mandatory?: boolean };
const ports = (list: Port[]): string =>
  `&[${list
    .map(
      (p) =>
        `(${q(p.name)}, ${TYPE[p.type]}, ${p.mandatory === undefined ? "None" : `Some(${p.mandatory})`})`,
    )
    .join(", ")}]`;

const types = Object.entries(MODULE_TYPES)
  .map(
    ([name, m]) =>
      `    TypeMeta {\n        name: ${q(name)},\n        kind: ModuleKind::${KIND[m.kind]},\n        inputs: ${ports(m.inputs)},\n        outputs: ${ports(m.outputs)},\n    },\n`,
  )
  .join("");
const io = Object.entries(IO_MODULES)
  .map(([n, { io }]) => `    (${q(n)}, ${q(io)}),\n`)
  .join("");

const text = `// types_generated.rs — GENERATED by packages/song-schema/scripts/genModuleTypes.mts from moduleTypes.ts; never edited by hand.
// Run \`npm run rebuild:generated\` after changing the tables there.

use super::types::TypeMeta;
use super::{ModuleKind, PortType};
use PortType::{Audio, Midi, Video};

/// The type folders, in the order the TypeScript walks them.
pub const MODULE_TYPES: [TypeMeta; ${Object.keys(MODULE_TYPES).length}] = [
${types}];

/// The io roles the app provides: node name and its \`io\`.
pub const IO_MODULES: [(&str, &str); ${Object.keys(IO_MODULES).length}] = [
${io}];

/// The io roles the signal comes FROM.
pub const IO_SOURCES: [&str; ${IO_SOURCES.length}] = [${IO_SOURCES.map(q).join(", ")}];
`;

if (process.argv.includes("--check")) {
  let have = "";
  try {
    have = readFileSync(OUT, "utf8");
  } catch {
    /* absent reads as stale */
  }
  if (have !== text) {
    console.error("types_generated.rs is stale");
    process.exit(1);
  }
} else writeFileSync(OUT, text);
