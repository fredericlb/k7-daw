{
  "name": "k7-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Headless C++ audio engine (Tracktion), served over WebSocket by the Rust server it links. Receives a compiled ProjectDoc over WebSocket, plays audio, pushes transport and meter state back. Never parses song files.",
  "license": "GPL-3.0-only",
  "scripts": {
    "build:win": "node scripts/build.mjs windows-msvc",
    "build:mac": "node scripts/build.mjs macos-clang",
    "build:android": "node scripts/build.mjs android-arm64",
    "build:ios": "node scripts/build.mjs ios-arm64",
    "gen:builtin-params": "node scripts/gen-builtin-params.mjs",
    "gen:strudel-bundle": "node scripts/gen-strudel-bundle.mjs",
    "gen:surge-panel": "node scripts/gen-surge-panel.mjs",
    "test": "npm run test:scripts && node scripts/run-tests.mjs",
    "test:settings-dir": "node scripts/settings-dir-proof.mjs",
    "test:all": "node scripts/run-tests.mjs --all",
    "typecheck": "tsc --noEmit -p scripts",
    "test:scripts": "vitest run --root scripts"
  },
  "devDependencies": {
    "@studio/engine-protocol": "*",
    "@studio/k7-wasm": "*",
    "@studio/web-protocol": "*",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.18.0"
  }
}
