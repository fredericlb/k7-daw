// Overdrive (one knob) — the DSP as data, read by the song crate (docs/dsp-literal-plan.md).
params({ Amount: { min: 0, max: 100, default: 0 } })
graph([
  lerp(1, 50, mul("Amount", 0.01)).as("drive"),
  lerp(1.313, 1.0, linmap("drive", 1, 4)).as("makeup"),
  output(amul(saturate(input(), "drive"), "makeup")),
])
