{
  "name": "@studio/commands",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Worker that holds the open project for its picture views and runs an import. The verbs themselves are the Rust crate apps/k7-daw-wasm/verbs, run by the backend's POST /verb. Consumed as source.",
  "exports": {
    "./runtime": "./src/runtime/runtime.ts",
    "./runtime/protocol": "./src/runtime/protocol.ts",
    "./runtime/importer": "./src/runtime/importer.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "dev": "tsc --noEmit --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run -c vitest.vfs.config.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@studio/web-protocol": "*",
    "@studio/engine-protocol": "*",
    "@studio/k7-wasm": "*",
    "@studio/song": "*",
    "@studio/song-schema": "*",
    "@studio/song-video": "*",
    "@studio/take-render": "*",
    "@studio/translator": "*",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
