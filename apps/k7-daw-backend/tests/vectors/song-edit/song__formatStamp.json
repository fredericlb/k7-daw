{"module":"song/formatStamp","blobs":{"0dee3db2ee3b":"extends(\"@meta/track\")\nevents([ref(\"kick\").start(\"1:1:1\"), ref(\"snare\").start(\"2:1:1\")])\n","0f9b3a2a5cd9":"// The ARRANGEMENT — the timeline, and the transport that rolls through it.\n//\n// A project draws one because it says so here: the timeline is a SURFACE\n// (packages/song/docs/surfaces.md), not something the editor hands out for free. Take this\n// file away and the song still compiles and still plays — you simply have no lanes on screen.\n//\n// `split` is what puts it in the layout, sharing the window with the graph underneath, and is\n// the only layout a timeline draws in. `view` is the other one: a screen of its own off the\n// header, which is where a turntables desk goes.\ntype(\"timeline\")\nlayout(\"split\")\n","12ae32cb1ec0":"","1745b1f8d2d9":"extends(\"@meta/group-track\")\ntracks([\"drums\"])\n","44849cfea071":{"size":88244},"4dfbdeddb007":{"size":7448},"5ed543c6ccda":"source(\"clips/shot.mp4\")\nsound(\"clips/shot.wav\")\n","6d99560c2713":"project({\n  name: \"node-demo\",\n  tempo: 120,\n  sampleRate: 48000,\n  timeSignature: \"4/4\",\n  video: false,\n})\nmarkers({})\nformat(4)\n","6f482c72b1fe":"extends(\"@meta/picture-track\")\nevents([ref(\"shot\").start(0).length(2)])\n","709e098df40b":"source(\"clips/shot.mp4\")\nsound(\"clips/shot-take.wav\")\n","73022dbebd80":"source(\"clips/snare.wav\")\n","7c5167761b5c":"source(\"clips/shot.mp4\")\nsound(\"clips/shot.sound.wav\")\n","8b48ecab3708":"source(\"clips/kick.wav\")\n","90b85959e1dd":"// The signal graph, as SEGMENTS: each module says where its signal goes next — the lane\n// \"drums\" included, since a lane is a module too. The chains are DERIVED by following the\n// arrows — a run breaks where the signal splits, and where two signals meet (which is what\n// a bus is).\n//\n// `bypassed` lists the modules the signal passes through untouched, and on a lane that is\n// its mute.\n\n// `MIX` is the mixer's sum and `OUT` is the interface; the run between them is the MASTER\n// CHAIN, and `OUT` carries the song's output level as its `Volume`. Name a module on that\n// line and it processes the whole mix on its way out.\n\nmodules({ drums: [\"MIX\"], MIX: [\"OUT\"] })\n","c01cde00ec19":"extends(\"@meta/picture-track\")\nevents([ref(\"shot\").start(0).length(2), ref(\"shot\").start(4).length(2)])\n","ceaddd126fda":"project({\n  name: \"node-demo\",\n  tempo: 120,\n  sampleRate: 48000,\n  timeSignature: \"4/4\",\n  video: false,\n})\nmarkers({})\n","e3e4a1a54f0f":{"size":9644}},"trees":{"28f1ea64f348":{"clips/kick.k7x":"8b48ecab3708","clips/kick.wav":"e3e4a1a54f0f","clips/shot-take.wav":"12ae32cb1ec0","clips/shot.k7x":"709e098df40b","clips/shot.mp4":"12ae32cb1ec0","clips/snare.k7x":"73022dbebd80","clips/snare.wav":"e3e4a1a54f0f","graph.k7x":"90b85959e1dd","nodes/drums.k7x":"0dee3db2ee3b","nodes/kit.k7x":"1745b1f8d2d9","nodes/main.k7x":"6f482c72b1fe","project.k7x":"ceaddd126fda","surfaces/timeline.k7x":"0f9b3a2a5cd9"},"a66a1d0296ea":{"clips/kick.k7x":"8b48ecab3708","clips/kick.wav":"e3e4a1a54f0f","clips/shot.k7x":"5ed543c6ccda","clips/shot.mp4":"12ae32cb1ec0","clips/shot.wav":"12ae32cb1ec0","clips/snare.k7x":"73022dbebd80","clips/snare.wav":"e3e4a1a54f0f","graph.k7x":"90b85959e1dd","nodes/drums.k7x":"0dee3db2ee3b","nodes/kit.k7x":"1745b1f8d2d9","nodes/main.k7x":"6f482c72b1fe","project.k7x":"ceaddd126fda","surfaces/timeline.k7x":"0f9b3a2a5cd9"},"b7b2a5e69336":{"clips/kick.k7x":"8b48ecab3708","clips/kick.wav":"e3e4a1a54f0f","clips/shot.k7x":"5ed543c6ccda","clips/shot.mp4":"12ae32cb1ec0","clips/shot.wav":"12ae32cb1ec0","clips/snare.k7x":"73022dbebd80","clips/snare.wav":"e3e4a1a54f0f","graph.k7x":"90b85959e1dd","nodes/drums.k7x":"0dee3db2ee3b","nodes/kit.k7x":"1745b1f8d2d9","nodes/main.k7x":"c01cde00ec19","project.k7x":"ceaddd126fda","surfaces/timeline.k7x":"0f9b3a2a5cd9"},"d1ea3f87577d":{"clips/kick.k7x":"8b48ecab3708","clips/kick.wav":"e3e4a1a54f0f","clips/shot-take.wav":"12ae32cb1ec0","clips/shot.