{
  "name": "k7-daw",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "workspaces": [
    "packages/*",
    "apps/k7",
    "apps/k7/frontend",
    "apps/k7/backend",
    "apps/k7-tray",
    "engine/k7-runtime",
    "engine/k7-android/web",
    "e2e"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:tray": "node scripts/dev-tray.mjs",
    "clean": "rm -rf node_modules packages/*/node_modules apps/*/node_modules apps/*/*/node_modules apps/*/*/*/node_modules",
    "tokens": "node scripts/tokens.mjs",
    "build": "npm run build --workspaces --if-present",
    "test": "node scripts/workspaces.mjs test",
    "test:console": "node --test \"scripts/console/*.test.mjs\"",
    "typecheck": "node scripts/workspaces.mjs typecheck",
    "check:changed": "node scripts/agent/check-changed.mjs",
    "rebuild:generated": "npx tsx packages/song-schema/scripts/genModuleTypes.mts && npm run build:wasm -w @studio/k7-wasm && npm run build:wasm -w @studio/audio-analysis",
    "ci:local": "bash scripts/agent/throttle.sh concurrently --group --names lint,bytes,docs,locks,rustfmt,typecheck,test,stages,vectors \"npm run lint\" \"npm run lint:bytes\" \"npm run lint:docs\" \"npm run lint:locks\" \"npm run lint:rustfmt\" \"npm run typecheck -- --jobs 2\" \"npm run test -- --jobs 3\" \"bash scripts/stage-gates.sh\" \"bash scripts/check-vectors.sh\"",
    "console": "npm install --prefix scripts/console --no-audit --no-fund && node scripts/console/server.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:bytes": "node scripts/check-source-bytes.mjs",
    "lint:docs": "node scripts/check-doc-links.mjs",
    "lint:locks": "node scripts/check-cargo-locks.mjs",
    "lint:rustfmt": "bash scripts/lint-rustfmt.sh",
    "lint:comments": "node scripts/check-comments.mjs",
    "lint:version": "node scripts/check-version.mjs",
    "lint:dead": "knip",
    "lint:panels": "tsx packages/song/scripts/checkPanelBinds.ts",
    "lint:layouts": "tsx packages/ui-module-builder/scripts/checkLayouts.ts",
    "engine:build": "node engine/scripts/build-engine.mjs",
    "test:e2e": "npm run e2e --workspace @studio/e2e --",
    "test:e2e:android": "npm run e2e:android --workspace @studio/e2e --",
    "test:e2e:ios": "npm run e2e:ios --workspace @studio/e2e --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@chromatic-com/storybook": "^5.2.1",
    "@inlang/paraglide-js": "^2.22.0",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/react-vite": "^10.5.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.0.1",
    "knip": "6.32.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.5.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "tsx": "^4.16.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.2",
    "yaml": "^2.5.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "10",
      "onFail": "ignore"
    }
  },
  "overrides": {
    "zod": "4.4.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true
  }
}
