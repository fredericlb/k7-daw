 {
  "name": "a file service asks to sync",
  "kind": "routes",
  "tree": {
   "seed/k7-core/modules/mix.k7x": "plugin(\"mixer\")\n",
   "seed/k7-core/.git/": ""
  },
  "seed": "$ROOT/seed",
  "steps": [
   {
    "op": "ask",
    "method": "POST",
    "path": "/libraries/sync",
    "body": {
     "name": "k7-core"
    }
   },
   {
    "op": "ask",
    "method": "POST",
    "path": "/libraries/sync",
    "body": {
     "name": "k7-core",
     "draft": true
    }
   },
   {
    "op": "ask",
    "method": "POST",
    "path": "/libraries/sync",
    "body": {}
   },
   {
    "op": "ask",
    "method": "POST",
    "path": "/libraries/sync",
    "body": {
     "name": "k7-core",
     "draft": "yes"
    }
   },
   {
    "op": "ask",
    "method": "GET",
    "path": "/libraries/sync"
   }
  ],
  "results": [
   {
    "status": 200,
    "body": {
     "notes": [
      {
       "name": "k7-core",
       "state": "current",
       "note": "here"
      }
     ]
    }
   },
   {
    "status": 200,
    "body": {
     "notes": [
      {
       "name": "k7-core",
       "state": "current",
       "note": "draft copied from version 1"
      }
     ]
    }
   },
   {
    "status": 200,
    "body": {
     "notes": [
      {
       "name": "k7-core",
       "state": "current",
       "note": "here"
      }
     ]
    }
   },
   {
    "status": 200,
    "body": {
     "notes": [
      {
       "name": "k7-core",
       "state": "current",
       "note": "here"
      }
     ]
    }
   },
   {
    "status": 404,
    "body": {
     "error": "no GET /libraries/sync"
    }
   }
  ],
  "after": {
   "data/libraries/k7-core/1/library.k7x": "name(\"k7-core\")\nversion(1)\nrequires(1)\n",
   "data/libraries/k7-core/1/modules/mix.k7x": "plugin(\"mixer\")\n",
   "data/libraries/k7-core/draft/modules/mix.k7x": "plugin(\"mixer\")\n",
