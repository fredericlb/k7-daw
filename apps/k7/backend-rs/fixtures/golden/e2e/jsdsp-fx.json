              "script": "// auto-wah — the reach from Low to High, and the band pass where the playing level puts it now.\n\nconst FONT = \"8px ui-monospace, monospace\";\nconst BLUE = \"#3d7dff\";\nconst GREEN = \"#3ec96b\";\nconst ORANGE = \"#ff6a1a\";\nconst GREY = \"#6b6b6b\";\nconst WHITE = \"#ffffff\";\nconst F_LO = 20;\nconst F_HI = 20000;\n\nconst num = (v, d) => (typeof v === \"number\" && Number.isFinite(v) ? v : d);\nconst clamp = (v, lo, hi) => (v < lo ? lo : v > hi ? hi : v);\nconst hz = (f) => (f >= 1000 ? `${(f / 1000).toFixed(f >= 10000 ? 0 : 1)}K` : `${Math.round(f)}`);\n\n// dB of the analog section (b0 s^2 + b1 s + b2) / (a0 s^2 + a1 s + a2) at s = jx.\nfunction sect(b, a, x) {\n  const nr = b[2] - b[0] * x * x;\n  const ni = b[1] * x;\n  const dr = a[2] - a[0] * x * x;\n  const di = a[1] * x;\n  const n = Math.max(1e-30, nr * nr + ni * ni);\n  const d = Math.max(1e-30, dr * dr + di * di);\n  return 10 * Math.log10(n / d);\n}\n\nconst LP = (q) => [[0, 0, 1], [1, 1 / Math.max(0.01, q), 1]];\nconst HP = (q) => [[1, 0, 0], [1, 1 / Math.max(0.01, q), 1]];\nconst BP = (q) => [[0, 1 / Math.max(0.01, q), 0], [1, 1 / Math.max(0.01, q), 1]];\nconst NOTCH = (q) => [[1, 0, 1], [1, 1 / Math.max(0.01, q), 1]];\n\n// dB of one second-order shape at frequency f for a corner fc.\nconst shape = (s, f, fc) => sect(s[0], s[1], f / Math.max(1e-6, fc));\n\nfunction glass(ctx, W, H) {\n  ctx.fillStyle = \"#000\";\n  ctx.fillRect(0, 0, W, H);\n  ctx.font = FONT;\n  ctx.lineWidth = 1;\n}\n\nconst frame = (W, H) => ({ x: 6, y: 13, w: Math.max(1, W - 12), h: Math.max(1, H - 19) });\nconst xOf = (b, f) => b.x + (Math.log(clamp(f, F_LO, F_HI) / F_LO) / Math.log(F_HI / F_LO)) * b.w;\nconst fOf = (b, px) => F_LO * (F_HI / F_LO) ** ((px - b.x) / Math.max(1, b.w));\nconst yOf = (b, db, lo, hi) => b.y + (1 - (clamp(db, lo, hi) - lo) / Math.max(1e-6, hi - lo)) * b.h;\n\n// The 0 dB line and a tick at 100 Hz, 1 kHz and 10 kHz.\nfunction grid(ctx, b, lo, hi) {\n  ctx.strokeStyle = GREY;\n  ctx.beginPath();\n  const y0 = Math.round(yOf(b, 0, lo, hi)) + 0.5;\n  ctx.moveTo(b.x, y0);\n  ctx.lineTo(b.x + b.w, y0);\n  for (const f of [100, 1000, 10000]) {\n    const x = Math.round(xOf(b, f)) + 0.5;\n    ctx.moveTo(x, b.y + b.h - 3);\n    ctx.lineTo(x, b.y + b.h);\n  }\n  ctx.stroke();\n}\n\nfunction curve(ctx, b, dbAt, lo, hi, color) {\n  ctx.strokeStyle = color;\n  ctx.beginPath();\n  for (let px = b.x; px <= b.x + b.w; px++) {\n    const y = yOf(b, dbAt(fOf(b, px)), lo, hi);\n    if (px === b.x) ctx.moveTo(px, y);\n    else ctx.lineTo(px, y);\n  }\n  ctx.stroke();\n}\n\nfunction dot(ctx, x, y, color) {\n  ctx.fillStyle = color;\n  ctx.beginPath();\n  ctx.arc(x, y, 2.5, 0, Math.PI * 2);\n  ctx.fill();\n}\n\nfunction text(ctx, s, x, y, color, align) {\n  ctx.fillStyle = color;\n  ctx.textAlign = align;\n  ctx.fillText(s, x, y);\n}\n\nexport default {\n  sweep(lcd) {\n    const { ctx, width: W, height: H, params, input } = lcd;\n    glass(ctx, W, H);\n    const b = frame(W, H);\n    let lo = clamp(num(params[\"Low\"], 200), 60, 8000);\n    let hi = clamp(num(params[\"High\"], 2400), 60, 8000);\n    if (hi < lo) [lo, hi] = [hi, lo];\n    const sens = clamp(num(params[\"Sensitivity\"], 0.5), 0, 1);\n    const q = clamp(num(params[\"Resonance\"], 4), 0.5, 20);\n    const down = num(params[\"Direction\"], 0) >= 0.5;\n    // The playing level against the sensitivity's floor, as the DSP maps it: -60 dB turned up, -15 dB turned down.\n    const last = Array.isArray(input) && input.length ? clamp(num(input[input.length - 1], 0), 0, 1) : 0;\n    const envDb = 20 * Math.log10(Math.max(1e-6, last));\n    const floor = -60 + 45 * sens;\n    const up = clamp((envDb - floor) / Math.max(1e-6, -floor), 0, 1);\n    const travel = down ? 1 - up : up;\n    const fc = lo * (hi / lo) ** travel;\n    // The span the wah can reach, between its two ends.\n    const x0 = xOf(b, lo);\n    const x1 = xOf(b, hi);\n    ctx.fillStyle = \"#3d7dff26\";\n    ctx.fillRect(x0, b.y, Math.max(1, x1 - x0), b.h);\n    ctx.strokeStyle = BLUE;\n    ctx.beginPath();\n    ctx.moveTo(Math.round(x0) + 0.5, b.y);\n    ctx.lineTo(Math.round(x0) + 0.5, b.y + b.h);\n    ctx.moveTo(Math.round(x1) + 0.5, b.y);\n    ctx.lineTo(Math.round(x1) + 0.5, b.y + b.h);\n    ctx.stroke();\n    grid(ctx, b, -30, 6);\n    curve(ctx, b, (f) => shape(BP(q), f, fc), -30, 6, ORANGE);\n    dot(ctx, xOf(b, fc), yOf(b, 0, -30, 6), GREEN);\n    text(ctx, down ? \"SWEEP DOWN\" : \"SWEEP UP\", b.x, 9, GREY, \"left\");\n    text(ctx, `${hz(fc)} HZ`, W - 6, 9, GREEN, \"right\");\n  },\n};\n",
