// Crossfade — the DSP as data, read by the song crate (docs/dsp-literal-plan.md).
// input(0) and input(1) index the ports module.k7x declares, in order: `a` then `b`.
params({
  Mix: { min: 0, max: 1, default: 0.5 },
})
graph([
  // Equal gain, not equal power: there is no sqrt among the primitives.
  output(aadd(amul(input(0), sub(1, "Mix")), amul(input(1), "Mix"))),
])
