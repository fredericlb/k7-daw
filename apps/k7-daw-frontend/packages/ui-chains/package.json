{
  "name": "@studio/ui-chains",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "k7's routing-graph engine — compiles a project graph to a layout the web app draws as HTML nodes + SVG cables. Framework-agnostic; consumed as source.",
  "exports": {
    "./anchorRight": "./src/anchorRight.ts",
    "./cableCanvas": "./src/cableCanvas.ts",
    "./cables": "./src/cables.ts",
    "./automationDepth": "./src/automationDepth.ts",
    "./graph": "./src/graph.ts",
    "./groupEdge": "./src/groupEdge.ts",
    "./hang": "./src/hang.ts",
    "./lcdScreen": "./src/lcdScreen.ts",
    "./widgetSandbox": "./src/widgetSandbox.ts",
    "./modulePreview": "./src/modulePreview.ts",
    "./multiSelect": "./src/multiSelect.ts",
    "./stackLayout": "./src/stackLayout.ts",
    "./noteLoad": "./src/noteLoad.ts",
    "./patchGesture": "./src/patchGesture.ts",
    "./rowSeams": "./src/rowSeams.ts",
    "./shownName": "./src/shownName.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@studio/graph-model": "*",
    "@studio/k7-wasm": "*",
    "@studio/song-schema": "*",
    "@studio/web-protocol": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
