            "dspGraph": "{\n  \"params\": [\n    {\n      \"name\": \"Amount\",\n      \"min\": 0,\n      \"max\": 100,\n      \"default\": 0\n    }\n  ],\n  \"nodes\": [\n    {\n      \"type\": \"mul\",\n      \"in\": [\n        \"Amount\",\n        0.01\n      ],\n      \"out\": \"n0\"\n    },\n    {\n      \"type\": \"lerp\",\n      \"in\": [\n        0.3,\n        3.3,\n        \"n0\"\n      ],\n      \"out\": \"n1\"\n    },\n    {\n      \"type\": \"mul\",\n      \"in\": [\n        \"n0\",\n        25\n      ],\n      \"out\": \"n2\"\n    },\n    {\n      \"type\": \"ain\",\n      \"out\": \"n3\"\n    },\n    {\n      \"type\": \"mul\",\n      \"in\": [\n        \"n1\",\n        0.23\n      ],\n      \"out\": \"n4\"\n    },\n    {\n      \"type\": \"alfo\",\n      \"k\": [\n        \"n4\"\n      ],\n      \"out\": \"n5\",\n      \"shape\": \"sine\"\n    },\n    {\n      \"type\": \"amul\",\n      \"out\": \"n6\",\n      \"in\": [\n        \"n5\"\n      ],\n      \"k\": [\n        \"n2\"\n      ]\n    },\n    {\n      \"type\": \"mul\",\n      \"in\": [\n        \"n1\",\n        0.71\n      ],\n      \"out\": \"n7\"\n    },\n    {\n      \"type\": \"alfo\",\n      \"k\": [\n        \"n7\"\n      ],\n      \"out\": \"n8\",\n      \"shape\": \"sine\"\n    },\n    {\n      \"type\": \"mul\",\n      \"in\": [\n        \"n2\",\n        0.6\n      ],\n      \"out\": \"n9\"\n    },\n    {\n      \"type\": \"amul\",\n      \"out\": \"n10\",\n      \"in\": [\n        \"n8\"\n      ],\n      \"k\": [\n        \"n9\"\n      ]\n    },\n    {\n      \"type\": \"mul\",\n      \"in\": [\n        \"n1\",\n        1.37\n      ],\n      \"out\": \"n11\"\n    },\n    {\n      \"type\": \"alfo\",\n      \"k\": [\n        \"n11\"\n      ],\n      \"out\": \"n12\",\n      \"shape\": \"sine\"\n    },\n    {\n      \"type\": \"mul\",\n      \"in\": [\n        \"n2\",\n        0.35\n      ],\n      \"out\": \"n13\"\n    },\n    {\n      \"type\": \"amul\",\n      \"out\": \"n14\",\n      \"in\": [\n        \"n12\"\n      ],\n      \"k\": [\n        \"n13\"\n      ]\n    },\n    {\n      \"type\": \"aadd\",\n      \"out\": \"n15\",\n      \"in\": [\n        \"n6\",\n        \"n10\"\n      ]\n    },\n    {\n      \"type\": \"aadd\",\n      \"out\": \"n16\",\n      \"in\": [\n        \"n15\",\n        \"n14\"\n      ]\n    },\n    {\n      \"type\": \"aadd\",\n      \"out\": \"n17\",\n      \"in\": [\n        \"n16\"\n      ],\n      \"k\": [\n        60\n      ]\n    },\n    {\n      \"type\": \"adelay\",\n      \"in\": [\n        \"n3\",\n        \"n17\"\n      ],\n      \"out\": \"n18\",\n      \"maxMs\": 130\n    },\n    {\n      \"type\": \"aout\",\n      \"in\": [\n        \"n18\"\n      ]\n    }\n  ]\n}\n",
