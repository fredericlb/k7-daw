                "amount": {"type": "knob", "col": 0, "row": 0, "colSpan": 2, "rowSpan": 2, "label": "Amount", "bind": "Amount", "min": 0, "max": 100},
                "sweep": {"type": "lcdscreen", "col": 2, "row": 0, "colSpan": 6, "rowSpan": 2}
              },
              "script": "// chorus — the tap's delay time over one second: 30 ms swept by a sine whose rate and depth both follow Amount.\n\nconst SWEEP = \"#3d7dff\";\nconst GRID = \"#6b6b6b\";\nconst FONT = \"8px ui-monospace, monospace\";\n\nconst clamp01 = (v) => (v < 0 ? 0 : v > 1 ? 1 : v);\n\nexport default {\n  sweep(lcd) {\n    const { ctx, width: W, height: H, params, output, state, now } = lcd;\n    ctx.fillStyle = \"#000\";\n    ctx.fillRect(0, 0, W, H);\n    ctx.font = FONT;\n\n    const pad = 6;\n    const top = 13;\n    const w = Math.max(1, W - pad * 2);\n    const h = Math.max(1, H - top - pad);\n    const mid = top + h / 2;\n    const amp = h / 2 - 1;\n\n    // dsp.k7x: rate 0.2 to 5 Hz and depth 0 to 20 ms, both linear in Amount; the axis spans 30 ± 20 ms.\n    const t = clamp01((params[\"Amount\"] ?? 0) / 100);\n    const rate = 0.2 + 4.8 * t;\n    const depth = 20 * t;\n\n    ctx.strokeStyle = GRID;\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(pad, Math.round(mid) + 0.5);\n    ctx.lineTo(W - pad, Math.round(mid) + 0.5);\n    ctx.stroke();\n\n    // One second of the sweep, scrolling while audio leaves the module.\n    const out = Array.isArray(output) && output.length ? clamp01(output[output.length - 1] ?? 0) : 0;\n    state.out = (state.out ?? 0) * 0.7 + out * 0.3;\n    const phase = state.out > 0.02 ? (now / 1000) * rate : 0;\n    ctx.strokeStyle = SWEEP;\n    ctx.beginPath();\n    for (let i = 0; i <= w; i++) {\n      const s = i / w;\n      const y = mid - Math.sin(2 * Math.PI * (rate * s + phase)) * amp * (depth / 20);\n      if (i === 0) ctx.moveTo(pad + i, y);\n      else ctx.lineTo(pad + i, y);\n    }\n    ctx.stroke();\n\n    ctx.fillStyle = SWEEP;\n    ctx.textAlign = \"left\";\n    ctx.fillText(`${rate.toFixed(1)} HZ`, pad, 9);\n    ctx.fillStyle = GRID;\n    ctx.textAlign = \"right\";\n    ctx.fillText(`30 ±${depth.toFixed(1)} MS`, W - pad, 9);\n  },\n};\n",
              "vertical": {
