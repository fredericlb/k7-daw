// Flanger — the DSP as data, read by the song crate (docs/dsp-literal-plan.md).
params({
  Rate: { min: 0.05, max: 10, default: 0.4 },
  Depth: { min: 0, max: 8, default: 3 },
  Centre: { min: 0.5, max: 12, default: 5 },
  Feedback: { min: 0, max: 0.9, default: 0.5 },
  Mix: { min: 0, max: 1, default: 0.5 },
})
wires("fb")
graph([
  input().as("dry"),
  aadd(amul(lfo("sine", "Rate"), "Depth"), "Centre").as("timeMs"),
  // The 20 ms ceiling is allocated once, so it bounds Centre + Depth.
  delay(aadd("dry", amul("fb", "Feedback")), "timeMs", 20).into("fb"),
  output(aadd("dry", "fb")),
  mix("Mix"),
])
