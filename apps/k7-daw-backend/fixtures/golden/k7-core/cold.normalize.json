      "drums": {
        "from": "drums",
        "use": [
          {
            "module": "fx",
            "uses": "@k7-core/cold/normalize",
            "category": "cold",
            "emits": "audio",
            "stub": false,
            "hasNativePluginUI": false,
            "ui": {
              "cols": 7,
              "rows": 2,
              "widgets": {
                "target": {"type": "knob", "col": 0, "row": 0, "colSpan": 2, "rowSpan": 2, "label": "Target", "bind": "Target", "min": -60, "max": 0},
                "peak": {"type": "meter", "col": 2, "row": 0, "rowSpan": 2, "label": "Peak", "bind": "Peak"},
                "gain_screen": {"type": "lcdscreen", "col": 3, "row": 0, "colSpan": 4, "rowSpan": 2}
              },
              "script": "// normalize screens — the dBFS column: the measured Peak, the Target, and the gain the module applies between them.\nconst FONT = \"8px ui-monospace, monospace\";\n\nexport default {\n  gain_screen(lcd) {\n    const { ctx, width: W, height: H, params } = lcd;\n    ctx.fillStyle = \"#000\";\n    ctx.fillRect(0, 0, W, H);\n    const target = params[\"Target\"] ?? -1;\n    const peak = params[\"Peak\"] ?? 0;\n    // Same clamp as dsp.k7x: the gain never exceeds -60..+30 dB.\n    const gain = Math.max(-60, Math.min(30, target - peak));\n    const top = 12;\n    const bottom = Math.max(top + 1, H - 4);\n    const y = (db) => top + (Math.min(0, Math.max(-60, db)) / -60) * (bottom - top);\n    const x0 = W * 0.35;\n    const x1 = W - 4;\n    ctx.strokeStyle = \"#6b6b6b\";\n    ctx.lineWidth = 1;\n    ctx.beginPath();\n    ctx.moveTo(x0, top);\n    ctx.lineTo(x0, bottom);\n    ctx.stroke();\n    ctx.fillStyle = \"#ffffff\";\n    ctx.fillRect(x0, y(peak) - 1, x1 - x0, 2);\n    ctx.fillStyle = \"#3d7dff\";\n    ctx.fillRect(x0, y(target) - 1, x1 - x0, 2);\n    const ax = (x0 + x1) / 2;\n    ctx.strokeStyle = \"#3ec96b\";\n    ctx.beginPath();\n    ctx.moveTo(ax, y(peak));\n    ctx.lineTo(ax, y(target));\n    ctx.stroke();\n    ctx.font = FONT;\n    ctx.fillStyle = \"#6b6b6b\";\n    ctx.fillText(\"PEAK\", 2, Math.max(top + 6, y(peak) + 3));\n    ctx.fillStyle = \"#3d7dff\";\n    ctx.fillText(\"TGT\", 2, Math.min(bottom, y(target) + 3));\n    ctx.fillStyle = \"#3ec96b\";\n    ctx.fillText(\"GAIN \" + (gain >= 0 ? \"+\" : \"\") + gain.toFixed(1) + \" DB\", 2, 9);\n  },\n};\n",
              "vertical": {
                "cols": 4,
                "rows": 4,
                "widgets": {
                  "target": {"type": "knob", "col": 0, "row": 0, "colSpan": 2, "rowSpan": 2, "label": "Target", "bind": "Target", "min": -60, "max": 0},
                  "peak": {"type": "meter", "col": 2, "row": 0, "rowSpan": 2, "label": "Peak", "bind": "Peak"},
                  "gain_screen": {"type": "lcdscreen", "col": 0, "row": 2, "colSpan": 4, "rowSpan": 2}
                }
              }
            },
            "params": {"Target": -1, "Peak": 0},
            "pluginId": "drums:fx"
          }
        ],
