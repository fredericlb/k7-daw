{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "vitest": {
    "config": ["vitest.config.ts"],
    "entry": [
      "**/*.{test,bench}.?(c|m)[jt]s?(x)",
      "**/__tests__/**/*.?(c|m)[jt]s?(x)"
    ]
  },
  "ignoreDependencies": [
    "tsx",
    "@vitejs/plugin-react",
    "@tailwindcss/vite",
    "esbuild"
  ],
  "ignoreBinaries": [
    "cmake",
    "ctest",
    "ffmpeg",
    "tilt",
    "where.exe"
  ],
  "ignore": [
    "apps/k7-daw-frontend/packages/*/scripts/rustSources.d.mts"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/**/*.mjs",
        "demos/_modules/**/widgets.js",
        "k7-core/modules/**/widgets.js",
        "apps/k7-daw-backend/scripts/*.mjs",
        "apps/k7-daw-ios/scripts/*.mjs",
        "apps/k7-daw-android/app/src/main/assets/*.js"
      ]
    },
    "apps/k7-daw-engine/k7-runtime": {
      "entry": ["scripts/*.{ts,mjs}", "engine/strudel/strudel.bundle.js"]
    },
    "apps/k7-daw-frontend": {
      "entry": ["src/docs/examples.ts", "notices/vendor.ts", "scripts/icons.mjs"]
    },
    "apps/k7-daw-desktop": {
      "entry": ["scripts/*.mjs"]
    },
    "e2e": {
      "entry": [
        "specs/*.setup.ts",
        "scripts/*.ts",
        "fixtures/_modules/**/widgets.js"
      ],
      "ignoreUnresolved": ["./gradlew"]
    },
    "apps/k7-daw-android/web": {
      "ignoreDependencies": ["@capacitor/android"]
    },
    "apps/k7-daw-frontend/packages/ui-module-builder": {
      "entry": ["scripts/*.ts"]
    },
    "apps/k7-daw-frontend/packages/k7-plugins": {
      "entry": ["scripts/turntables/*.ts"]
    },
    "apps/k7-daw-frontend/packages/audio-analysis": {
      "entry": ["scripts/*.mjs"]
    },
    "apps/k7-daw-frontend/packages/k7x": {
      "entry": ["bench/*.{ts,mjs}", "scripts/*.mjs"]
    },
    "apps/k7-daw-frontend/packages/k7-wasm": {
      "entry": ["scripts/*.mjs"]
    },
    "apps/k7-daw-frontend/packages/ui-chains-react": {}
  }
}
