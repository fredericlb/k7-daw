# Copy to .env beside compose.yaml and fill in (docs/forgejo-pages.md). .env is never committed.

# The site's domain: Forgejo answers at git.<DOMAIN>, the site at <DOMAIN>.
DOMAIN=k7.rocks
# https on a server (Caddy fetches the certificates); http only for a local trial.
SCHEME=https
# Let's Encrypt's contact for the certificates.
ACME_EMAIL=

# Where the published ports listen: 0.0.0.0 on a server, 127.0.0.1 for a local trial.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Git over SSH; the host's own sshd keeps 22.
SSH_PORT=2222

# Forgejo's, git-pages' and Caddy's data (Caddy's holds the certificates).
DATA_DIR=./data

# The runner's identity on Forgejo: the UUID and the 40-hex secret from `forgejo-cli actions register`.
RUNNER_UUID=
RUNNER_TOKEN=
