project({
  name: "video.k7",
  tempo: 120,
  sampleRate: 48000,
  timeSignature: "4/4",

  // PICTURE. A song carries its own, and this field is what a lane of it needs.
  //
  // `viewport` is the frame every lane draws into: [width, height, fps]. There is no
  // default — a frame invented by the loader would silently letterbox every shot, and you
  // would find out at the export. The fps is used by EXPORT only; playing back follows
  // the transport.
  viewport: [1280, 720, 30],
})
format(5)
